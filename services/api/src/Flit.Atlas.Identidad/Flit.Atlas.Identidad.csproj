<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Flit.Atlas.Identidad</RootNamespace>
    <!-- Las migraciones generadas por EF no siguen todas las reglas de análisis. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lista local de contraseñas comunes y textos legales (HU 1.5, ATLAS-ADR-0025). -->
    <EmbeddedResource Include="Externos\contrasenas-comunes.txt" />
    <EmbeddedResource Include="Externos\Legal\*.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Flit.Atlas.Plataforma\Flit.Atlas.Plataforma.csproj" />
    <ProjectReference Include="..\Flit.Atlas.ServiceDefaults\Flit.Atlas.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Flit.Atlas.Api.Tests" />
  </ItemGroup>
</Project>
