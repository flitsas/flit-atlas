{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identidad": {
    "Tokens": {
      "Clientes": {
        "atlas-cli": {
          "Nombre": "Atlas CLI",
          "Tipo": "Publico",
          "Flujos": [ "authorization_code", "refresh_token" ],
          "RedirectUris": [ "http://127.0.0.1/callback" ],
          "Scopes": [ "openid", "profile", "offline_access", "atlas.publicar" ]
        },
        "atlas-mcp": {
          "Nombre": "Servidor MCP de Atlas",
          "Tipo": "Publico",
          "Flujos": [ "authorization_code", "refresh_token" ],
          "RedirectUris": [ "http://127.0.0.1/mcp/callback" ],
          "Scopes": [ "openid", "profile", "offline_access", "atlas.mcp" ]
        }
      }
    }
  }
}
