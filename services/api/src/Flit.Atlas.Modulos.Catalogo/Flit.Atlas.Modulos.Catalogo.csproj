<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Flit.Atlas.Modulos.Catalogo</RootNamespace>
    <!-- Las migraciones generadas por EF no siguen todas las reglas de análisis. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Un módulo solo depende del núcleo (ATLAS-ADR-0016): nunca de otro módulo ni de Identidad. Lo verifica
         ArquitecturaModulosTests. -->
    <ProjectReference Include="..\Flit.Atlas.Plataforma\Flit.Atlas.Plataforma.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Semilla del catálogo (ATLAS-ADR-0028): va dentro del ensamblado para que el migrador no dependa de archivos sueltos. -->
    <EmbeddedResource Include="Semilla\aplicativos.json" LogicalName="Flit.Atlas.Modulos.Catalogo.Semilla.aplicativos.json" />
    <!-- Lista blanca inicial de publicación desde la CI (HU 3.1, ATLAS-ADR-0035). -->
    <EmbeddedResource Include="Semilla\fuentes-publicacion.json" LogicalName="Flit.Atlas.Modulos.Catalogo.Semilla.fuentes-publicacion.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Flit.Atlas.Modulos.Catalogo.Tests" />
    <InternalsVisibleTo Include="Flit.Atlas.Api.Tests" />
  </ItemGroup>
</Project>
