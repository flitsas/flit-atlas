{
  "entryFile": "src/index.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "src/**/*Controller.ts"
  ],
  "spec": {
    "outputDirectory": "./",
    "specVersion": 3,
    "securityDefinitions": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "name": "API externa ICT · Trámites (BackApiExternalTransact)",
    "version": "3.0.0",
    "description": "Registro, pausa y anulación de trámites de gestores externos y consulta de secretarías de tránsito.",
    "contact": {
      "name": "FLIT S.A.S."
    }
  },
  "ignore": [
    "**/node_modules/**"
  ],
  "routes": {
    "routesDir": "build",
    "authenticationModule": "src/app/middlewares/authenticationMiddleware.ts"
  }
}
