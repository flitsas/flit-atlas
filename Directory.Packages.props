<Project>
  <!--
    Versiones centralizadas. Regla del prompt maestro §5.2: estable y con al menos 2 semanas de publicada.
    Revisadas el 21/10/2026.
    Excepción: el conjunto 10.0.x de Microsoft (EF Core y ASP.NET Core) va en 10.0.13, el parche de seguridad del
    13/10/2026 (System.Security.Cryptography.Xml y Pkcs, varias de gravedad alta). Un parche de seguridad pesa más que
    la regla de las 2 semanas.
  -->
  <ItemGroup Label="Aspire (AppHost)">
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.Python" Version="13.6.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Golang" Version="13.6.0" />
  </ItemGroup>
  <ItemGroup Label="Integraciones cliente">
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.6.0" />
    <PackageVersion Include="Aspire.RabbitMQ.Client" Version="13.6.0" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.0" />
  </ItemGroup>
  <ItemGroup Label="Persistencia y mensajería">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>
  <ItemGroup Label="Identidad">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.16.0" />
    <!-- La que ya trae Microsoft.Identity.Web 4.16.0; el módulo de equipo la usa para el JWT de la GitHub App. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <!-- Servidor de tokens (HU 1.3c, ATLAS-ADR-0024). Apache-2.0; 7.7.1 del 17/09/2026 ya trae el arreglo de
         GHSA-925x-4h4v-2792. La 7.7.2 (10/10/2026) no tiene 2 semanas y no trae arreglos de seguridad. -->
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.1" />
  </ItemGroup>
  <ItemGroup Label="Contratos">
    <!-- OpenAPI 3.1 generado desde el código (HU 1.7, ATLAS-ADR-0021). Mismo conjunto 10.0.13 de ASP.NET Core. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Plataforma">
    <!-- Web Push con VAPID (HU 1.6, ATLAS-ADR-0020). MIT; en net6+ usa la criptografía de .NET, sin BouncyCastle. -->
    <PackageVersion Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <!-- Correo por SMTP (HU 1.5, ATLAS-ADR-0025). MIT. MimeKit se fija en la misma versión (4.18.2 tiene menos de 2 semanas). -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="MimeKit" Version="4.18.1" />
    <!-- QR del TOTP como SVG (HU 1.5). MIT, sin dependencias. -->
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>
  <ItemGroup Label="Transitivas fijadas por seguridad">
    <!-- Aspire.Hosting 13.6.0 trae 2.5.302 (GHSA-qhrr-8q5h-9q3h, moderada). Quitar cuando Aspire la suba. -->
    <PackageVersion Include="MessagePack" Version="2.5.303" />
    <!-- Microsoft.Identity.Web 4.16.0 trae 10.0.10 (GHSA-846f-f764-76mx alta y GHSA-2fmv-rv2c-59x7 moderada). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Pruebas">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.15.0" />
  </ItemGroup>
</Project>
